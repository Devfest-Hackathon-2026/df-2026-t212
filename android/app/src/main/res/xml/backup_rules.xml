<?xml version="1.0" encoding="utf-8"?>
<!-- Only device-bound secure storage is excluded. Photo library data keeps its
     existing backup behavior. Android Keystore keys cannot be restored. -->
<full-backup-content>
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
</full-backup-content>
